# ---- mode: paper (default) | live
EXEC_MODE=paper
# required for live:
# EXEC_LIVE_CONFIRM=I_UNDERSTAND_REAL_MONEY

# ---- limits
EXEC_MAX_SIZE_PER_MARKET=20
EXEC_MAX_DAILY_LOSS=10
EXEC_MAX_UNHEDGED=1
EXEC_MIN_LIQUIDITY_MULT=1.5
EXEC_MAX_SLIPPAGE=0.01
EXEC_MIN_EDGE=0.005
EXEC_MAX_BALANCE=200
EXEC_BALANCE_LIMIT_BLOCKS_TRADING=true
EXEC_MAX_SIGNAL_AGE_S=30
EXEC_MAX_LAG_S=120

# ---- execution / unwind
EXEC_UNWIND_MAX_SLIPPAGE=0.03
EXEC_UNWIND_RETRIES=3

# ---- safety
EXEC_HEARTBEAT_INTERVAL_S=5
EXEC_HEARTBEAT_MAX_FAILURES=3
EXEC_KILL_FILE=data/KILL

# ---- storage / alerts
EXEC_DB_PATH=data/execution.sqlite
EXEC_JOURNAL_PATH=data/journal.jsonl
# EXEC_ALERT_WEBHOOK_URL=https://...

# ---- paper
EXEC_PAPER_START_BALANCE=100
EXEC_PAPER_FEE_BPS=0

# ---- Polymarket (live only). Dedicated wallet, minimal USDC!
# EXEC_PRIVATE_KEY=0x...
# EXEC_FUNDER=0x...        # proxy address from your Polymarket profile
# EXEC_SIGNATURE_TYPE=1
